opter_drone.dir/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c.obj CMakeFiles/Quadcopter_drone.dir/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim_ex.c.obj CMakeFiles/Quadcopter_drone.dir/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_uart.c.obj CMakeFiles/Quadcopter_drone.dir/Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_uart_ex.c.obj CMakeFiles/Quadcopter_drone.dir/FreeRTOS-KernelV11.2.0/list.c.obj CMakeFiles/Quadcopter_drone.dir/FreeRTOS-KernelV11.2.0/portable/GCC/ARM_CM4F/port.c.obj CMakeFiles/Quadcopter_drone.dir/FreeRTOS-KernelV11.2.0/portable/MemMang/heap_4.c.obj CMakeFiles/Quadcopter_drone.dir/FreeRTOS-KernelV11.2.0/queue.c.obj CMakeFiles/Quadcopter_drone.dir/FreeRTOS-KernelV11.2.0/tasks.c.obj CMakeFiles/Quadcopter_drone.dir/startup_stm32l476xx.s.obj
  CONFIG = Debug
  FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -Wextra -Wpedantic -fdata-sections -ffunction-sections -O0 -g3 -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -Wextra -Wpedantic -fdata-sections -ffunction-sections -O0 -g3 -g
  LINK_FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wl,-Map=Quadcopter_drone.map -Wl,--gc-sections -Wl,--start-group -lc -lm -Wl,--end-group -Wl,--print-memory-usage -TD:/Quadcopter_Drone_code/STM32L476RGTx_FLASH.ld -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16 -Wl,--gc-sections -Wl,-Map=Quadcopter_drone.map --specs=nano.specs --specs=nosys.specs
  LINK_LIBRARIES = -lm
  OBJECT_DIR = CMakeFiles\Quadcopter_drone.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = Quadcopter_drone.elf
  TARGET_PDB = Quadcopter_drone.elf.dbg
  TARGET_SUPPORT_DIR = CMakeFiles\Quadcopter_drone.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Quadcopter_Drone_code\build\Debug && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\Quadcopter_Drone_code -BD:\Quadcopter_Drone_code\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Quadcopter_Drone_code\build\Debug && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\Quadcopter_Drone_code -BD:\Quadcopter_Drone_code\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

